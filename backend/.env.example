GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_key_here
CEREBRAS_API_KEY=your_cerebras_key_here
NEXT_PUBLIC_HF_API_URL=https://your-hf-space-url.hf.space

# Optional: Hugging Face Space ID (if running on Spaces)
# SPACE_ID=your-space-id

# ==============================================================================
# Development & Testing (Local Only)
# ==============================================================================
# Set to 'true' to bypass actual API calls and use canned JSON fixtures from backend/tests/fixtures/
# Prevents burning API quotas during UI testing and debugging.
# IMPORTANT: This will cause the backend to refuse to start if SPACE_ID is set (production failsafe).
USE_MOCK_LLM=false

# If USE_MOCK_LLM=true, you can force specific test scenarios. 
# Supported values: clean (default), anomalous, agent_a_fail, agent_b_fail, both_fail, retry_success, retry_fail
MOCK_SCENARIO=clean
